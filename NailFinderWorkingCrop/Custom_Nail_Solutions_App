    def closeEvent(self, event):
        """Ensures the camera thread is stopped gracefully on application exit."""
        if self.capture_thread and self.capture_thread.isRunning():
            self.capture_thread.stop()
            self.capture_thread.wait()
        event.accept()

    def _check_camera_connected(self):
        """Return True if a RealSense camera is connected, False otherwise."""
        try:
            context = rs.context()
            return bool(context.query_devices())
        except Exception:
            return False

    def _update_camera_status_label(self):
        connected = self._check_camera_connected()
        if connected:
            self.camera_status_label.setText("Camera: Connected")
            self.camera_status_label.setStyleSheet("color: green; font-weight: bold;")
        else:
            self.camera_status_label.setText("Camera: Disconnected")
            self.camera_status_label.setStyleSheet("color: red; font-weight: bold;")

    def _set_active_menu(self, menu_to_toggle):
        """
        Helper to manage the visibility of sliding menus. Shows the selected
        menu and hides all others. Toggles visibility if the same menu is selected again.
        """
        self.clear_view_loaded_files()
        
        is_different_menu = self.active_menu is not menu_to_toggle
        
        # Hide all menus
        self.menu.setVisible(False)
        self.processes_menu.setVisible(False)
        self.view_menu.setVisible(False)
        
        if is_different_menu:
            menu_to_toggle.setVisible(True)
            self.active_menu = menu_to_toggle
            is_processes = menu_to_toggle is self.processes_menu
            self.content_area.setVisible(is_processes)
        else:
            self.active_menu = None
            self.content_area.setVisible(False)

    def _choose_loaded_file(self, key, caption='Select file'):
        """If multiple files are loaded for `key`, prompt the user to choose one.

        Returns the chosen file path or None.
        """
        files = self.loaded_files.get(key) or []
        if not files:
            return None
        if len(files) == 1:
            return files[0]

        # Ask the user to choose from the loaded files
        items = [os.path.basename(p) for p in files]
        item, ok = QInputDialog.getItem(self, caption, 'Choose file:', items, 0, False)
        if ok and item:
            # find full path
            for p in files:
                if os.path.basename(p) == item:
                    return p
        return None

    def toggle_menu(self):
        self._set_active_menu(self.menu)

    def toggle_processes(self):
        self._set_active_menu(self.processes_menu)

    def toggle_view(self):
        self._set_active_menu(self.view_menu)

    def open_load_dialog(self):
        dialog = LoadDialog(self, close_on_load=self.settings.get('close_load_dialog_on_select', True))
        if dialog.exec():
            # Only add existing files and avoid duplicates
            for key in self.loaded_files:
                for fp in dialog.loaded_files.get(key, []):
                    if not os.path.exists(fp):
                        # Inform the user but continue
                        QMessageBox.warning(self, "File Not Found", f"Skipped missing file: {fp}")
                        continue
                    if fp not in self.loaded_files[key]:
                        self.loaded_files[key].append(fp)

            # If the user currently has the view open, refresh it
            if self.view_loaded_files_active:
                # Rebuild view to reflect new files
                self.clear_view_loaded_files()
                self.view_loaded_files()

    def _load_settings(self):
        try:
            if os.path.exists(self.settings_path):
                with open(self.settings_path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    # only update keys we know
                    for k in self.settings.keys():
                        if k in data:
                            self.settings[k] = data[k]
        except Exception:
            # ignore settings load problems
            pass

    def _save_settings(self):
        try:
            with open(self.settings_path, 'w', encoding='utf-8') as f:
                json.dump(self.settings, f, indent=2)
        except Exception:
            # best-effort; ignore
            pass

    def remove_file(self, file_type, file_path, widget_to_remove):
        if file_path in self.loaded_files[file_type]:
            self.loaded_files[file_type].remove(file_path)
        widget_to_remove.setParent(None)
        widget_to_remove.deleteLater()

    def clear_view_loaded_files(self):
        if self.view_loaded_files_active:
            for i in reversed(range(self.content_layout.count())):
                widget = self.content_layout.itemAt(i).widget()
                if widget and widget is not self.stream_label:
                    widget.setParent(None)
                    widget.deleteLater()
            self.view_loaded_files_active = False
            # Make sure the permanent stream_label is hidden if we clear the view
            self.stream_label.clear()

    def _create_file_widget(self, file_type, path):
        file_widget = QWidget()
        file_layout = QHBoxLayout(file_widget)

        if file_type == "jpeg_png" and os.path.exists(path):
            pixmap = QPixmap(path).scaledToWidth(200, Qt.TransformationMode.SmoothTransformation)
            label = QLabel()
            label.setPixmap(pixmap)
            file_layout.addWidget(label)
        else:
            label_text = os.path.basename(path)
            if not os.path.exists(path):
                label_text = f"NOT FOUND: {label_text}"
            label = QLabel(label_text)
            file_layout.addWidget(label)
        
        file_layout.addStretch()

        if file_type in ["ply", "stl"] and os.path.exists(path):
            view_button = QPushButton("View")
            view_button.setStyleSheet("color: blue; font-weight: bold;")
            view_func = self.view_ply_file if file_type == "ply" else self.view_stl_file
            view_button.clicked.connect(lambda _, p=path: view_func(p))
            file_layout.addWidget(view_button)

        remove_button = QPushButton("X")
        remove_button.setFixedSize(20, 20)
        remove_button.setStyleSheet("color: red; font-weight: bold;")
        remove_button.clicked.connect(lambda: self.remove_file(file_type, path, file_widget))
        file_layout.addWidget(remove_button)

        return file_widget
        
    def view_loaded_files(self):
        if self.view_loaded_files_active:
            self.clear_view_loaded_files()
            self.content_area.setVisible(False)
            return

        self.clear_view_loaded_files()
        self.view_loaded_files_active = True
        self.content_area.setVisible(True)

        if not any(self.loaded_files.values()):
            label = QLabel("No files loaded.")
            label.setStyleSheet("color: grey; font-size: 16px; padding: 10px;")
            self.content_layout.addWidget(label)
            return

        for file_type, paths in self.loaded_files.items():
            if paths:
                header_label = QLabel(f"{file_type.upper()} Files:")
                header_label.setStyleSheet("font-weight: bold; font-size: 14px; margin-top: 10px;")
                self.content_layout.addWidget(header_label)
                for path in paths:
                    file_widget = self._create_file_widget(file_type, path)
                    self.content_layout.addWidget(file_widget)
        
        self.content_layout.addStretch()

    def view_ply_file(self, file_path, render_settings=None):
        try:
            geometry = o3d.io.read_triangle_mesh(file_path)
            if not geometry.has_triangles():
                geometry = o3d.io.read_point_cloud(file_path)
            if geometry.is_empty():
                QMessageBox.warning(self, "Error", f"Unable to load valid geometry from {os.path.basename(file_path)}")
                return
            # Run viewer in background thread to avoid blocking the UI
            viewer = Open3DViewerThread(geometry, settings=render_settings, window_name=f"Viewing {os.path.basename(file_path)}")
            self._o3d_threads.append(viewer)
            # remove from list when finished
            viewer.finished.connect(lambda _, v=viewer: self._o3d_threads.remove(v) if v in self._o3d_threads else None)
            viewer.start()
        except Exception as e:
            QMessageBox.critical(self, "Open3D Error", f"Could not read file: {e}")

    def view_stl_file(self, file_path, render_settings=None):
        try:
            geometry = o3d.io.read_triangle_mesh(file_path)
            if not geometry.has_triangles():
                QMessageBox.warning(self, "Error", f"Unable to load valid geometry from {os.path.basename(file_path)}")
                return
            geometry.compute_vertex_normals()
            viewer = Open3DViewerThread(geometry, settings=render_settings, window_name=f"Viewing {os.path.basename(file_path)}")
            self._o3d_threads.append(viewer)
            viewer.finished.connect(lambda _, v=viewer: self._o3d_threads.remove(v) if v in self._o3d_threads else None)
            viewer.start()
        except Exception as e:
            QMessageBox.critical(self, "Open3D Error", f"Could not read file: {e}")

