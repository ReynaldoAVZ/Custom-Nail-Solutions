class LoadDialog(QDialog):
    """
    A dialog window that allows users to load different types of files.
    Each button opens a file dialog specific to that file type.
    """
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Load Options")
        self.loaded_files = {"jpeg_png": [], "npy": [], "ply": [], "stl": []}
        self.setFixedSize(300, 200)
        
        layout = QVBoxLayout(self)

        # Create buttons for each file type
        self.jpeg_png_button = QPushButton("Load JPEG/PNG", self)
        self.jpeg_png_button.clicked.connect(self.load_jpeg_png)
        layout.addWidget(self.jpeg_png_button)

        self.ply_button = QPushButton("Load .PLY File", self)
        self.ply_button.clicked.connect(self.load_ply)
        layout.addWidget(self.ply_button)

        self.npy_button = QPushButton("Load .NPY File", self)
        self.npy_button.clicked.connect(self.load_npy)
        layout.addWidget(self.npy_button)

        self.stl_button = QPushButton("Load .STL File", self)
        self.stl_button.clicked.connect(self.load_stl)
        layout.addWidget(self.stl_button)

        # Add a close button
        button_box = QDialogButtonBox(QDialogButtonBox.StandardButton.Close, self)
        button_box.rejected.connect(self.reject)
        layout.addWidget(button_box)

    def _load_files(self, file_type, title, name_filter):
        """
        Helper function to open a file dialog and load files of a specific type.

        Args:
            file_type (str): The key for storing file paths in self.loaded_files (e.g., "ply").
            title (str): The title of the file dialog window.
            name_filter (str): The filter for file extensions (e.g., "PLY Files (*.ply)").
        """
        file_dialog = QFileDialog(self)
        file_dialog.setFileMode(QFileDialog.FileMode.ExistingFiles)
        file_dialog.setNameFilter(name_filter)
        if file_dialog.exec():
            selected_files = file_dialog.selectedFiles()
            self.loaded_files[file_type].extend(selected_files)
            QMessageBox.information(self, title, "Loaded:\n" + "\n".join(selected_files))
            self.accept() # Close the dialog after successful loading

    def load_jpeg_png(self):
        """Opens a dialog to load JPEG or PNG images."""
        self._load_files("jpeg_png", "Load JPEG/PNG", "Image Files (*.jpeg *.jpg *.png)")

    def load_ply(self):
        """Opens a dialog to load PLY files."""
        self._load_files("ply", "Load PLY", "PLY Files (*.ply)")

    def load_npy(self):
        """Opens a dialog to load NumPy .npy files."""
        self._load_files("npy", "Load NPY", "NumPy Files (*.npy)")

    def load_stl(self):
        """Opens a dialog to load STL files."""
        self._load_files("stl", "Load STL", "STL Files (*.stl)")

class SlidingMenu(QWidget):
    """
    A simple collapsible menu widget containing a vertical list of buttons.
    """
    def __init__(self, parent=None, options=None):
        super().__init__(parent)
        self.setFixedWidth(200)
        self.setStyleSheet("background-color: #f0f0f0;")
        self.layout = QVBoxLayout(self)
        self.setLayout(self.layout)
        if options:
            for option in options:
                self.add_option(option)

    def add_option(self, name):
        """
        Adds a new button (option) to the menu.

        Args:
            name (str): The text to display on the button.

        Returns:
            QPushButton: The created button widget.
        """
        button = QPushButton(name, self)
        button.setStyleSheet("text-align: left; padding: 10px; background-color: #4CAF50; color: white; font-weight: bold;")
        self.layout.addWidget(button)
        return button
        
class MainWindow(QMainWindow):
    """
