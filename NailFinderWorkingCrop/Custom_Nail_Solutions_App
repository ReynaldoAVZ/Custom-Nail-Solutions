class ImageViewerDialog(QDialog):
    """Image viewer with zoom (wheel/slider/keys) and pan (mouse drag / arrow keys).

    The viewer keeps the cursor point stable when zooming with the wheel.
    """
    def __init__(self, image_path, parent=None, initial_width=400):
        super().__init__(parent)
        self.setWindowTitle(f"Viewing Image: {os.path.basename(image_path)}")
        self.image_path = image_path
        self.layout = QVBoxLayout(self)

        self.label = QLabel(self)
        self.label.setBackgroundRole(QPalette.ColorRole.Base)
        self.label.setSizePolicy(self.label.sizePolicy().horizontalPolicy(), self.label.sizePolicy().verticalPolicy())
        self.pix = QPixmap(image_path)
        self.scale = 1.0
        self.initial_width = int(initial_width)

        # Scroll area to host the label for native panning
        from PyQt6.QtWidgets import QScrollArea
        self.scroll = QScrollArea(self)
        self.scroll.setWidgetResizable(False)
        self.scroll.setWidget(self.label)
        self.layout.addWidget(self.scroll)

        # Controls: Zoom slider plus Reset / Fit buttons
        ctrl_layout = QHBoxLayout()

        self.slider = QSlider(Qt.Orientation.Horizontal, self)
        self.slider.setRange(10, 800)
        self.slider.setValue(100)
        self.slider.valueChanged.connect(self._on_slider_changed)
        ctrl_layout.addWidget(self.slider)

        self.reset_btn = QPushButton("Reset", self)
        self.reset_btn.clicked.connect(self.reset_view)
        ctrl_layout.addWidget(self.reset_btn)

        self.fit_btn = QPushButton("Fit to Window", self)
        self.fit_btn.clicked.connect(self.fit_to_window)
        ctrl_layout.addWidget(self.fit_btn)

        self.layout.addLayout(ctrl_layout)

        # Install event filter on the viewport to capture mouse/wheel events
        self.scroll.viewport().installEventFilter(self)

        # Initialize display
        self._apply_scale_to_label()

    def _apply_scale_to_label(self, focus_point=None):
        """Scale the pixmap and adjust scrollbars so that focus_point (viewport coords)
        remains pointing to the same image pixel. If focus_point is None, keep center."""
        if self.pix.isNull():
            self.label.setText("Failed to load image")
            return

        orig_w = self.pix.width()
        orig_h = self.pix.height()
        new_w = max(1, int(orig_w * self.scale))
        new_h = max(1, int(orig_h * self.scale))

        # compute focus proportions
        hbar = self.scroll.horizontalScrollBar()
        vbar = self.scroll.verticalScrollBar()
        vw = self.scroll.viewport().width()
        vh = self.scroll.viewport().height()

        if focus_point is None:
            # keep center
            focus_x = hbar.value() + vw / 2
            focus_y = vbar.value() + vh / 2
        else:
            focus_x = hbar.value() + focus_point.x()
            focus_y = vbar.value() + focus_point.y()

        # proportions within the scaled image
        old_scaled_w = int(orig_w * (self.scale if self.scale != 0 else 1))
        # Prevent division by zero
        if old_scaled_w <= 0:
            prop_x = 0.5
        else:
            prop_x = focus_x / old_scaled_w

        old_scaled_h = int(orig_h * (self.scale if self.scale != 0 else 1))
        if old_scaled_h <= 0:
            prop_y = 0.5
        else:
            prop_y = focus_y / old_scaled_h

        # Apply new pixmap
        scaled = self.pix.scaled(new_w, new_h, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
        self.label.setPixmap(scaled)
        self.label.resize(scaled.size())

        # compute new scrollbar values so that the same proportion is under the viewport
        new_scaled_w = scaled.width()
        new_scaled_h = scaled.height()

        new_hval = int(prop_x * new_scaled_w - (focus_point.x() if focus_point is not None else vw / 2))
        new_vval = int(prop_y * new_scaled_h - (focus_point.y() if focus_point is not None else vh / 2))

        # clamp values
        new_hval = max(0, min(new_hval, max(0, new_scaled_w - vw)))
        new_vval = max(0, min(new_vval, max(0, new_scaled_h - vh)))

        hbar.setValue(new_hval)
        vbar.setValue(new_vval)

    def _on_slider_changed(self, value):
        # keep viewport center as focus
        focus = None
        self.scale = value / 100.0
        try:
            vw = self.scroll.viewport().width()
            vh = self.scroll.viewport().height()
            focus = QPoint(int(vw / 2), int(vh / 2))
        except Exception:
            focus = None
        self._apply_scale_to_label(focus_point=focus)

    def reset_view(self):
        """Reset zoom to 100% and center the image in the viewport."""
        self.scale = 1.0
        self.slider.setValue(100)
        # center
        self._apply_scale_to_label()

    def fit_to_window(self):
        """Adjust scale so the image fits the viewport while preserving aspect ratio."""
        vw = max(1, self.scroll.viewport().width())
        vh = max(1, self.scroll.viewport().height())
        if self.pix.isNull():
            return
        iw = self.pix.width()
        ih = self.pix.height()
        # compute scale to fit
        scale_x = vw / iw
        scale_y = vh / ih
        new_scale = min(scale_x, scale_y)
        # clamp to slider range
        new_scale = max(0.01, min(20.0, new_scale))
        self.scale = new_scale
        self.slider.setValue(int(self.scale * 100))
        # keep center as focus so image is centered
        self._apply_scale_to_label()

    def eventFilter(self, obj, event):
        # Handle mouse press/move/release/wheel on the viewport
        from PyQt6.QtCore import QEvent
        if obj is self.scroll.viewport():
            if event.type() == QEvent.Type.MouseButtonPress:
                if event.button() == Qt.MouseButton.LeftButton:
                    self._dragging = True
                    self._last_pos = event.position()
                    return True
            elif event.type() == QEvent.Type.MouseMove:
                if getattr(self, '_dragging', False):
                    cur = event.position()
                    delta = cur - self._last_pos
                    self._last_pos = cur
                    h = self.scroll.horizontalScrollBar()
                    v = self.scroll.verticalScrollBar()
                    h.setValue(int(h.value() - delta.x()))
                    v.setValue(int(v.value() - delta.y()))
                    return True
            elif event.type() == QEvent.Type.MouseButtonRelease:
                if event.button() == Qt.MouseButton.LeftButton:
                    self._dragging = False
                    return True
            elif event.type() == QEvent.Type.Wheel:
                # Zoom centered on cursor
                try:
                    angle = event.angleDelta().y()
                except Exception:
                    angle = 0
                if angle == 0:
                    return False
                factor = 1.0 + (0.001 * angle)
                # compute new scale but clamp
                new_scale = max(0.01, min(20.0, self.scale * factor))
                # compute focus point in viewport coords
                pos = event.position()
                focus = QPoint(int(pos.x()), int(pos.y()))
                self.scale = new_scale
                # update slider without triggering loop
                self.slider.blockSignals(True)
                self.slider.setValue(int(self.scale * 100))
                self.slider.blockSignals(False)
                self._apply_scale_to_label(focus_point=focus)
                return True
        return super().eventFilter(obj, event)

    def keyPressEvent(self, event):
        # arrow keys to pan; +/- to zoom; 0 to reset
        key = event.key()
        h = self.scroll.horizontalScrollBar()
        v = self.scroll.verticalScrollBar()
        step = 50
        if key == Qt.Key.Key_Left:
            h.setValue(max(0, h.value() - step))
        elif key == Qt.Key.Key_Right:
            h.setValue(min(h.maximum(), h.value() + step))
        elif key == Qt.Key.Key_Up:
            v.setValue(max(0, v.value() - step))
        elif key == Qt.Key.Key_Down:
            v.setValue(min(v.maximum(), v.value() + step))
        elif key in (Qt.Key.Key_Plus, Qt.Key.Key_Equal):
            self.scale = min(20.0, self.scale * 1.1)
            self.slider.setValue(int(self.scale * 100))
            self._apply_scale_to_label()
        elif key == Qt.Key.Key_Minus:
            self.scale = max(0.01, self.scale / 1.1)
            self.slider.setValue(int(self.scale * 100))
            self._apply_scale_to_label()
        elif key == Qt.Key.Key_0:
            self.scale = 1.0
            self.slider.setValue(100)
            self._apply_scale_to_label()
        else:
            super().keyPressEvent(event)


class RenderSettingsDialog(QDialog):
    """Dialog to pick simple rendering settings for Open3D viewers."""
    @staticmethod
    def get_settings(parent=None):
        dlg = QDialog(parent)
        dlg.setWindowTitle("Render Settings")
        dlg.setFixedSize(380, 240)
        layout = QVBoxLayout(dlg)

        # Point size
        ps_layout = QHBoxLayout()
        ps_layout.addWidget(QLabel("Point size:"))
        ps_spin = QSpinBox(dlg)
        ps_spin.setRange(1, 20)
        ps_spin.setValue(2)
        ps_layout.addWidget(ps_spin)
        layout.addLayout(ps_layout)

        # Background color picker
        bg_layout = QHBoxLayout()
        bg_layout.addWidget(QLabel("Background color:"))
        bg_color_btn = QPushButton("Choose color", dlg)
        bg_color_preview = QLabel(dlg)
        bg_color_preview.setFixedSize(40, 20)
        bg_color_preview.setStyleSheet("background-color: rgb(0,0,0);")
        def _pick_color():
            col = QColorDialog.getColor(parent=dlg)
            if col.isValid():
                rgb = col.getRgb()[:3]
                bg_color_preview.setStyleSheet(f"background-color: rgb({rgb[0]},{rgb[1]},{rgb[2]});")
                bg_color_btn.setProperty('rgb', rgb)
        bg_color_btn.clicked.connect(_pick_color)
        bg_layout.addWidget(bg_color_btn)
        bg_layout.addWidget(bg_color_preview)
        layout.addLayout(bg_layout)

        # Lighting / show normals toggles
        opts_layout = QHBoxLayout()
        lighting_cb = QCheckBox("Enable lighting")
        lighting_cb.setChecked(True)
        normals_cb = QCheckBox("Show normals")
        normals_cb.setChecked(False)
        opts_layout.addWidget(lighting_cb)
        opts_layout.addWidget(normals_cb)
        layout.addLayout(opts_layout)

        # Camera preset
        cam_layout = QHBoxLayout()
        cam_layout.addWidget(QLabel("Camera preset:"))
        cam_combo = QPushButton("Default")
        cam_layout.addWidget(cam_combo)
        layout.addLayout(cam_layout)

        # Buttons
        btn_row = QHBoxLayout()
        ok = QPushButton("OK")
        cancel = QPushButton("Cancel")
        btn_row.addWidget(ok)
        btn_row.addWidget(cancel)
        layout.addLayout(btn_row)

        result = {}
        def _on_ok():
            result['point_size'] = int(ps_spin.value())
            rgb = bg_color_btn.property('rgb') if bg_color_btn.property('rgb') else (0,0,0)
            result['bg_rgb'] = rgb
            result['lighting'] = bool(lighting_cb.isChecked())
            result['show_normals'] = bool(normals_cb.isChecked())
            result['camera_preset'] = cam_combo.text()
            dlg.accept()

        ok.clicked.connect(_on_ok)
        cancel.clicked.connect(dlg.reject)

        if dlg.exec() == QDialog.DialogCode.Accepted:
            return result
        return None


class Open3DViewerThread(QThread):
    """Run an Open3D visualizer in a background QThread to avoid blocking the UI."""
    def __init__(self, geometry, settings=None, window_name="Open3D Viewer"):
        super().__init__()
        self.geometry = geometry
        self.settings = settings or {}
        self.window_name = window_name

    def run(self):
        try:
            vis = o3d.visualization.Visualizer()
            vis.create_window(window_name=self.window_name)
            vis.add_geometry(self.geometry)
            opt = vis.get_render_option()
            if 'point_size' in self.settings:
                try:
                    opt.point_size = float(self.settings['point_size'])
                except Exception:
                    pass
            if 'bg_rgb' in self.settings:
                rgb = self.settings['bg_rgb']
                try:
                    opt.background_color = np.asarray([rgb[0]/255.0, rgb[1]/255.0, rgb[2]/255.0])
                except Exception:
                    pass
            vis.run()
            vis.destroy_window()
        except Exception:
            # If Open3D fails inside the thread, we can't show a QMessageBox here safely
            pass


def _open3d_viewer_with_settings(geometry, render_settings=None, window_name="Open3D Viewer"):
    vis = o3d.visualization.Visualizer()
    vis.create_window(window_name=window_name)
    vis.add_geometry(geometry)
    ctr = vis.get_view_control()
    opt = vis.get_render_option()
    if render_settings:
        if 'point_size' in render_settings:
            try:
                opt.point_size = float(render_settings['point_size'])
            except Exception:
                pass
        if 'bg' in render_settings:
            if render_settings['bg'] == 'light':
                opt.background_color = np.asarray([1.0, 1.0, 1.0])
            else:
                opt.background_color = np.asarray([0.0, 0.0, 0.0])
    vis.run()
    vis.destroy_window()

class LoadDialog(QDialog):
    """
    A dialog window that allows users to load different types of files.
    Each button opens a file dialog specific to that file type.
    """
    def __init__(self, parent=None, close_on_load=True):
        super().__init__(parent)
        self.setWindowTitle("Load Options")
        # store loaded files local to dialog until user closes (MainWindow will pull them)
        self.loaded_files = {"jpeg_png": [], "npy": [], "ply": [], "stl": []}
        self.setFixedSize(320, 220)
        # whether the dialog should close automatically after selecting files
        self.close_on_load = bool(close_on_load)
        
        layout = QVBoxLayout(self)

        # Create buttons for each file type
        self.jpeg_png_button = QPushButton("Load JPEG/PNG", self)
        self.jpeg_png_button.clicked.connect(self.load_jpeg_png)
        layout.addWidget(self.jpeg_png_button)

        self.ply_button = QPushButton("Load .PLY File", self)
        self.ply_button.clicked.connect(self.load_ply)
        layout.addWidget(self.ply_button)

        self.npy_button = QPushButton("Load .NPY File", self)
        self.npy_button.clicked.connect(self.load_npy)
        layout.addWidget(self.npy_button)

        self.stl_button = QPushButton("Load .STL File", self)
        self.stl_button.clicked.connect(self.load_stl)
        layout.addWidget(self.stl_button)

        # Add a close button
        button_box = QDialogButtonBox(QDialogButtonBox.StandardButton.Close, self)
        button_box.rejected.connect(self.reject)
        layout.addWidget(button_box)

    def _load_files(self, file_type, title, name_filter):
        """
        Helper function to open a file dialog and load files of a specific type.

        Args:
            file_type (str): The key for storing file paths in self.loaded_files (e.g., "ply").
            title (str): The title of the file dialog window.
            name_filter (str): The filter for file extensions (e.g., "PLY Files (*.ply)").
        """
        file_dialog = QFileDialog(self)
        file_dialog.setFileMode(QFileDialog.FileMode.ExistingFiles)
        file_dialog.setNameFilter(name_filter)
        if file_dialog.exec():
            selected_files = file_dialog.selectedFiles()
            # extend without duplicates
            for p in selected_files:
                if p not in self.loaded_files[file_type]:
                    self.loaded_files[file_type].append(p)

            QMessageBox.information(self, title, "Loaded:\n" + "\n".join(selected_files))
            # Only close if configured to do so
            if self.close_on_load:
                self.accept()

    def load_jpeg_png(self):
        """Opens a dialog to load JPEG or PNG images."""
        self._load_files("jpeg_png", "Load JPEG/PNG", "Image Files (*.jpeg *.jpg *.png)")

    def load_ply(self):
        """Opens a dialog to load PLY files."""
        self._load_files("ply", "Load PLY", "PLY Files (*.ply)")

    def load_npy(self):
        """Opens a dialog to load NumPy .npy files."""
        self._load_files("npy", "Load NPY", "NumPy Files (*.npy)")

    def load_stl(self):
        """Opens a dialog to load STL files."""
        self._load_files("stl", "Load STL", "STL Files (*.stl)")

class SlidingMenu(QWidget):
    """
    A simple collapsible menu widget containing a vertical list of buttons.
    """
    def __init__(self, parent=None, options=None):
        super().__init__(parent)
        self.setFixedWidth(200)
        self.setStyleSheet("background-color: #f0f0f0;")
        self.layout = QVBoxLayout(self)
        self.setLayout(self.layout)
        if options:
            for option in options:
                self.add_option(option)

    def add_option(self, name):
        """
        Adds a new button (option) to the menu.

        Args:
            name (str): The text to display on the button.

        Returns:
            QPushButton: The created button widget.
        """
        button = QPushButton(name, self)
        button.setStyleSheet("text-align: left; padding: 10px; background-color: #4CAF50; color: white; font-weight: bold;")
        self.layout.addWidget(button)
        return button
        
