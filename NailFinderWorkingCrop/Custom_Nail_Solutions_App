            try:
                # --- Establish Serial Connection with Arduino ---
                ARDUINO_PORT = '/dev/ttyACM0'  # <--- IMPORTANT: Check your port name!
                BAUD_RATE = 9600
                try:
                    ser = serial.Serial(ARDUINO_PORT, BAUD_RATE, timeout=1)
                    time.sleep(2)  # Wait for Arduino to reset and establish connection
                    self.log(f"Successfully connected to Arduino on {ARDUINO_PORT}")
                except serial.SerialException as e:
                    # Use QMessageBox for GUI-based error reporting
                    QMessageBox.warning(self, "Arduino Warning", f"Could not connect to Arduino on {ARDUINO_PORT}.\nRunning without servo/LED control.\nError: {e}")
                    ser = None # Ensure ser is None if connection fails

                # --- Helper function to send commands ---
                def send_command(command_string):
                    if ser and ser.is_open:
                        self.log(f"Sending to Arduino: '{command_string}'")
                        ser.write(command_string.encode('utf-8'))
                        time.sleep(0.05) # Small delay for command processing

                # Initialize RealSense pipeline
                config = rs.config()
                config.enable_stream(rs.stream.depth, 640, 480, rs.format.z16, 30)
                config.enable_stream(rs.stream.color, 640, 480, rs.format.bgr8, 30)
                profile = pipeline.start(config)

                # Get camera intrinsics
                depth_stream = profile.get_stream(rs.stream.depth)
                intr = depth_stream.as_video_stream_profile().get_intrinsics()
                intrinsic = o3d.camera.PinholeCameraIntrinsic(
                    width=intr.width, height=intr.height, fx=intr.fx, fy=intr.fy, cx=intr.ppx, cy=intr.ppy
                )
                # NOTE: Your rotated_intrinsic logic is kept as is
                try:
                    rotated_intrinsic = o3d.camera.PinholeCameraIntrinsic(
                        width=intr.height, height=intr.width, fx=intr.fy, fy=intr.fx,
                        cx=intr.ppy, cy=float(intr.width) - float(intr.ppx) - 1.0
                    )
                except Exception:
                    rotated_intrinsic = intrinsic

                # TSDF volume setup
                volume = o3d.pipelines.integration.ScalableTSDFVolume(
                    voxel_length=0.01, sdf_trunc=0.04,
                    color_type=o3d.pipelines.integration.TSDFVolumeColorType.RGB8
                )

                # --- SCANNING SEQUENCE ---
                send_command("L1") # 1. Send command for all-white lights

                angles = [80, 100, 120, 140, 160, 180, 200, 220]
                for angle_deg in angles:
                    frame_idx += 1 # Increment frame counter

                    # 2. Send servo command to Arduino
                    send_command(f"S{angle_deg}")

                    # 3. Wait for servo to move to the new position
                    time.sleep(0.75) # Adjust this delay based on your servo's speed

                    # 4. Capture and process the frame
                    frames = pipeline.wait_for_frames()
                    depth_frame = frames.get_depth_frame()
                    color_frame = frames.get_color_frame()

                    if not depth_frame or not color_frame:
                        continue

                    depth_np = np.array(depth_frame.get_data())
                    color_np = np.array(color_frame.get_data())

                    # Your image rotation logic is kept as is
                    try:
                        depth_np = cv2.rotate(depth_np, cv2.ROTATE_90_COUNTERCLOCKWISE)
                        color_np = cv2.rotate(color_np, cv2.ROTATE_90_COUNTERCLOCKWISE)
                    except Exception:
                        pass

                    depth_image = o3d.geometry.Image(depth_np)
                    color_image = o3d.geometry.Image(color_np)

                    # --- MODIFIED: Extrinsic Matrix Calculation (Rotation Fix) ---
                    offset = np.array([0.0, 0.0, 0.05])
                    angle_rad = math.radians(angle_deg)
                    c, s = math.cos(angle_rad), math.sin(angle_rad)

                    # FIX: Changing rotation axis from X to Z for a sweeping motion 
                    # over a flat surface (horizontal arc).
                    R = np.array([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=float)

                    T_neg_offset = np.eye(4); T_neg_offset[:3, 3] = -offset
                    T_rotation = np.eye(4); T_rotation[:3, :3] = R
                    T_pos_offset = np.eye(4); T_pos_offset[:3, 3] = offset
                    extrinsic = T_pos_offset @ T_rotation @ T_neg_offset

                    rgbd = o3d.geometry.RGBDImage.create_from_color_and_depth(
                        color_image, depth_image, depth_scale=1000.0,
                        depth_trunc=5.0, convert_rgb_to_intensity=False
                    )

                    # Use intrinsic that matches the expected rotation
                    intrinsic_to_use = rotated_intrinsic 
                    try:
                        # Integrate into TSDF volume
                        volume.integrate(rgbd, rotated_intrinsic, extrinsic)
                    except Exception:
                        # Fallback to default intrinsic if the rotated one fails
                        intrinsic_to_use = intrinsic
                        volume.integrate(rgbd, intrinsic, extrinsic)

                    # --- NEW: Save Individual Point Cloud for Analysis ---
                    pcd_frame = o3d.geometry.PointCloud.create_from_rgbd_image(
                        rgbd, intrinsic_to_use
                    )

                    # Apply the camera's pose transformation
                    pcd_frame.transform(extrinsic)

                    # Save the individual point cloud with frame info
                    individual_save_path = os.path.join(
                        save_dir, f'frame_{frame_idx:02d}_angle_{angle_deg}deg_{timestamp}.ply'
                    )
                    o3d.io.write_point_cloud(individual_save_path, pcd_frame)
                    self.log(f"Saved individual frame: {individual_save_path}")

                # --- POST-SCAN ACTIONS ---
                send_command("L2") # 5. Send command for rainbow mode
                send_command(f"S{angles[0]}") # Reset servo to the starting angle

                # Extract and save the final combined point cloud
                mesh = volume.extract_triangle_mesh()
                pcd = mesh.sample_points_uniformly(number_of_points=200000)

                final_save_path = os.path.join(save_dir, f'tsdf_fusion_FINAL_{timestamp}.ply')
                o3d.io.write_point_cloud(final_save_path, pcd)

                if final_save_path not in self.loaded_files['ply']:
                    self.loaded_files['ply'].append(final_save_path)

                QMessageBox.information(self, "Success", f"Scan complete. Final point cloud saved to: {final_save_path}\n({frame_idx} individual frames also saved.)")

            except Exception as e:
                QMessageBox.critical(self, "Error", f"Failed to generate point cloud: {str(e)}")

            finally:
                # --- CLEANUP ---
                pipeline.stop()
                # MODIFIED: Ensure serial port is closed properly
                if ser and ser.is_open:
                    ser.close()
                    self.log("Arduino serial connection closed.")
                    
class CaptureDialog(QDialog):
    """
    A dialog to get user input for the number of frames, delay, and filename
    for the image capture process.
    """
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Capture Images")
        self.setFixedSize(300, 200)

        layout = QVBoxLayout(self)

        self.frames_input = QLineEdit(self)
        self.frames_input.setPlaceholderText("e.g., 5")
        layout.addWidget(QLabel("Number of Frames:"))
        layout.addWidget(self.frames_input)

        self.delay_input = QLineEdit(self)
        self.delay_input.setPlaceholderText("e.g., 3")
        layout.addWidget(QLabel("Delay Before Start (seconds):"))
        layout.addWidget(self.delay_input)

        self.filename_input = QLineEdit(self)
        self.filename_input.setPlaceholderText("e.g., HandScan_01")
        layout.addWidget(QLabel("Base File Name:"))
        layout.addWidget(self.filename_input)

        self.button_box = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel, self)
        self.button_box.accepted.connect(self.accept)
        self.button_box.rejected.connect(self.reject)
        layout.addWidget(self.button_box)

    def get_inputs(self):
        """
        Validates and returns the user's input.

        Returns:
            tuple: (frames, delay, fileName) or (None, None, None) if input is invalid.
        """
        try:
            frames = int(self.frames_input.text())
            delay = int(self.delay_input.text())
            fileName = self.filename_input.text()
            if frames <= 0 or delay < 0 or not fileName.strip():
                raise ValueError("Inputs must be valid.")
            return frames, delay, fileName
        except ValueError:
            QMessageBox.warning(self, "Invalid Input", "Please enter a positive integer for frames, a valid delay, and a non-empty filename.")
            return None, None, None


class ImageCaptureThread(QThread):
    """
    A QThread that continuously captures frames from a RealSense camera
    to prevent the GUI from freezing.
    """
    image_ready = pyqtSignal(np.ndarray)
    camera_error = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self._running = True

    def run(self):
        """
        The main thread loop. Initializes the camera and captures frames
        until stopped.
        """
        pipeline = None
        try:
            # Proactive check for connected devices
            context = rs.context()
            if not context.query_devices():
                # If no devices are found, emit the error signal and exit the thread
                self.camera_error.emit("No RealSense camera connected. Please check the connection and restart.")
                return 

            pipeline = rs.pipeline()
            config = rs.config()
            config.enable_stream(rs.stream.color, 640, 480, rs.format.bgr8, 30)
            
            pipeline.start(config)
            
            while self._running:
                frames = pipeline.wait_for_frames()
                color_frame = frames.get_color_frame()
                if not color_frame:
                    continue

                color_image = np.asanyarray(color_frame.get_data())
                self.image_ready.emit(color_image)
        
        except Exception as e:
            # If any other runtime error occurs, emit it
            self.camera_error.emit(f"An unexpected camera error occurred: {e}")

        finally:
            if pipeline:
                pipeline.stop()

    def stop(self):
        """Stops the thread's execution loop."""
        self._running = False
        self.wait() # Wait for the thread to finish cleanly


