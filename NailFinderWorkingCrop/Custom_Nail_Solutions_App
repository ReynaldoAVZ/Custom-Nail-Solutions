    """
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Custom Nail Solutions App")
        self.setGeometry(100, 100, 1000, 800)

        # Application state
        self.loaded_files = {"jpeg_png": [], "npy": [], "ply": [], "stl": []}
        self.view_loaded_files_active = False
        self.capture_thread = None
        self.camera_found = True
        self.active_menu = None

        # --- UI Setup ---
        main_widget = QWidget(self)
        self.setCentralWidget(main_widget)
        main_layout = QHBoxLayout(main_widget)

        # Left panel for menus
