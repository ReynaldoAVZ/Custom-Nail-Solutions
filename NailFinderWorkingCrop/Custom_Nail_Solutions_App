        self.menu_button.setStyleSheet("background-color: #2196F3; color: white; font-weight: bold;")
        self.menu_button.clicked.connect(self.toggle_menu)
        button_layout.addWidget(self.menu_button)

        self.processes_button = QPushButton("Processes", self)
